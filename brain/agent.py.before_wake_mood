class LLMClient:
    """Клиент для работы с Anthropic Claude API"""
    
    def __init__(self, api_key: str, model: str):
        self.client = AsyncAnthropic(api_key=api_key)
        self.model = model
    
    async def generate_response(
        self,
        system_prompt: str,
        user_message: str,
        context: List[Tuple[str, str]] = None
    ) -> str:
        """Сгенерировать ответ через Claude API"""
        
        # Формируем сообщения для Claude
        messages = []
        
        # Добавляем контекст (история сообщений)
        if context:
            for role, content in context:
                # Преобразуем роли для Claude
                claude_role = "user" if role == "user" else "assistant"
                messages.append({
                    "role": claude_role,
                    "content": content
                })
        
        # Добавляем текущее сообщение (обёрнутое в теги для безопасности)
        messages.append({
            "role": "user",
            "content": f"<user_message>{user_message}</user_message>"
        })
        
        try:
            response = await self.client.messages.create(
                model=self.model,
                max_tokens=150,
                system=system_prompt,
                messages=messages
            )
            
            return response.content[0].text.strip()
            
        except Exception as e:
            print(f"Claude API Error: {e}")
            return "..."

