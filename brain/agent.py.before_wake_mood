def _prepare_tts(text: str) -> str:
    """Подготовка текста для TTS: паузы и ударения."""
    import re
    # Ударение в имени кошки: Лу́на (ударение на первый слог, не лунА).
    # Используем несколько нотаций: + перед ударной гласной + combining acute.
    text = re.sub(r'\bЛуна\b', 'Лу\u0301+на', text)
    text = re.sub(r'\bлуна\b', 'лу\u0301+на', text)
    # Двойные паузы после точек и запятых для более естественной речи
    text = re.sub(r'\.\s+', '.. ', text)
    text = re.sub(r',\s+', ',, ', text)
    return text


def detect_explicit_scene(text: str):
