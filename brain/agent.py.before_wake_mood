class ElinaBot:
    """Основной класс Telegram-бота"""
    
    def __init__(self):
        proxy_url = os.getenv("TELEGRAM_PROXY")
        if proxy_url and proxy_url.strip():
            connector = ProxyConnector.from_url(proxy_url)
            session = AiohttpSession(connector=connector)
            self.bot = Bot(token=config.TELEGRAM_BOT_TOKEN, session=session)
        else:
            self.bot = Bot(token=config.TELEGRAM_BOT_TOKEN)
        
        self.dp = Dispatcher()
        
        # Инициализация компонентов
        self.memory = MemoryDB(str(config.DB_PATH))
        self.soul = SoulManager(
            str(config.SOUL_MD_PATH),
            str(config.TRUST_LEVELS_PATH)
        )
        self.behavior = BehaviorEngine()
        self.llm = LLMClient(
            config.ANTHROPIC_API_KEY,
            config.MODEL
        )
        self.validator = OutputValidator()

        # Голосовые сообщения (ElevenLabs TTS)
        self.tts = ElevenLabsTTS(
            api_key=os.getenv("ELEVENLABS_API_KEY", ""),
            db_path=str(config.DB_PATH),
            daily_limit=int(os.getenv("ELEVENLABS_DAILY_LIMIT", "200")),
