        )
        self.voice_cache = VoiceCache(cache_dir=str(config.DB_PATH.parent / "voice_cache"))
        self.voice_counter = VoiceStreakCounter(db_path=str(config.DB_PATH), owner_id=OWNER_ID)
        self.stt = DeepgramSTT(api_key=os.getenv("DEEPGRAM_API_KEY", ""))

        # Резолв internal user_id владельца — для bypass trust-level
        self._owner_db_id = None
        if OWNER_ID:
            try:
                _conn = sqlite3.connect(str(config.DB_PATH))
                _row = _conn.execute(
                    "SELECT id FROM users WHERE telegram_id = ?", (str(OWNER_ID),)
                ).fetchone()
                _conn.close()
                if _row:
                    self._owner_db_id = _row[0]
            except Exception as _e:
                print(f"OWNER_ID resolve warning: {_e}")

        # Словарь для отслеживания проактивных сообщений
        self._proactive_sent = {}

        # Защита от дублирования обработки сообщений
        self._processing_users = set()
        
        # Регистрируем хендлеры
        self.register_handlers()

    def _trust_for(self, user_id: int) -> int:
        """Возвращает trust_level. Для владельца (OWNER_ID) — всегда 5."""
        if self._owner_db_id is not None and user_id == self._owner_db_id:
            return 5
        return self.memory.get_trust_level(user_id)

    def get_sleep_schedule(self) -> dict:
        """Рандомный график сна по дню недели (стабильный в рамках недели)"""
        schedules = [
            {"sleep": 23, "wake": 9},
            {"sleep": 23, "wake": 10},
            {"sleep": 0, "wake": 9},
            {"sleep": 0, "wake": 10},
            {"sleep": 1, "wake": 10},
            {"sleep": 1, "wake": 11},
            {"sleep": 2, "wake": 11},
            {"sleep": 3, "wake": 12},
        ]
        now_tz = datetime.now(ELINA_TZ)
        day = now_tz.weekday()
        week = now_tz.isocalendar()[1]
        rng = random.Random(day + week)
        return rng.choice(schedules)

    @staticmethod
    def _mentions_elina(text: str) -> bool:
        """Упоминает ли сообщение имя Элины"""
        return bool(re.search(r'элин[ауеёыой]?|elina', text.lower()))

    def _ensure_wake_columns(self):
        """Миграция: добавить поля wake в таблицу users если отсутствуют"""
        try:
            conn = sqlite3.connect(Config.DB_PATH)
            cur = conn.cursor()
            for col, typedef in [
                ("elina_name_count", "INTEGER DEFAULT 0"),
                ("wake_until", "TIMESTAMP DEFAULT NULL"),
            ]:
                try:
                    cur.execute(f"ALTER TABLE users ADD COLUMN {col} {typedef}")
                except Exception:
                    pass  # колонка уже есть
            conn.commit()
            conn.close()
        except Exception as e:
            print(f"Wake column migration error: {e}")

    def _is_sleeping(self, user_id: int = None) -> bool:
        """Спит ли Элина прямо сейчас по графику"""
        # Проверяем принудительное пробуждение по wake_until в БД
        if user_id is not None:
            try:
                conn = sqlite3.connect(Config.DB_PATH)
                cur = conn.cursor()
                cur.execute("SELECT wake_until FROM users WHERE id = ?", (user_id,))
                row = cur.fetchone()
                conn.close()
                if row and row[0]:
                    wake_until = datetime.fromisoformat(str(row[0]))
                    if wake_until.tzinfo is None:
                        wake_until = pytz.utc.localize(wake_until)
                    if datetime.now(pytz.utc) < wake_until:
                        return False  # принудительно не спим
            except Exception as e:
                print(f"Wake check error: {e}")

        schedule = self.get_sleep_schedule()
        hour = datetime.now(ELINA_TZ).hour
        sleep_hour = schedule["sleep"]
        wake_hour = schedule["wake"]
        if sleep_hour > wake_hour:  # переход через полночь
            return hour >= sleep_hour or hour < wake_hour
        return sleep_hour <= hour < wake_hour

    async def enrich_with_knowledge(self, user_message: str, trust_level: int) -> str:
        """Добавить контекст из learned_facts или веб-поиска"""
        question_key = user_message.lower().strip()[:100]

        learned = self.memory.get_learned_fact(question_key)
        if learned:
            return f"<learned_fact>{learned}</learned_fact>"

        search_triggers = [
            "что думаешь", "как относишься", "знаешь кто такие",
            "слышала про", "что такое", "кто такой", "кто такая",
            "какой фильм", "какую музыку", "посоветуй", "знаешь ли"
        ]
        needs_search = any(t in question_key for t in search_triggers)

        if needs_search and trust_level >= 1:
            searcher = WebSearcher()
            result = await searcher.search(user_message)
            if result:
                return f"<web_result>{result}</web_result>"

        return ""

    def register_handlers(self):
        """Регистрация обработчиков сообщений"""
        
        ALLOWED_USERS = [277565921]

        @self.dp.message(CommandStart())
        async def cmd_start(message: Message):
            """Обработчик /start"""
            if message.from_user.id not in ALLOWED_USERS:
                return
            user_id = self.memory.get_or_create_user(
                str(message.from_user.id),
                message.from_user.username,
                message.from_user.first_name
            )

            trust_level = self._trust_for(user_id)
            mood = self.behavior.get_mood_by_hour()

            greetings = [
                "привет) я элина...",
                "дороее... ой, доброе*",
                "привет. хм... приятно",
                "ой, привет! не ожидала"
            ]
            
            greeting = random.choice(greetings)
            
            await message.answer(greeting)
        
        @self.dp.message()
        async def handle_message(message: Message):
            """Обработчик всех сообщений"""
            if message.from_user.id not in ALLOWED_USERS:
                return
            is_voice = bool(message.voice)
            if not message.text and not is_voice:
                return

            if is_voice:
                _transcript = await self.stt.transcribe_voice(message, self.bot)
                if _transcript:
                    incoming_text = _transcript
                else:
                    # STT не сработал — отвечаем сразу, не передаём Claude
                    _stt_fail_replies = [
                        "не расслышала... повтори?",
                        "хм... не поняла. напиши?",
                        "что-то не разобрала. ещё раз?",
                        "плохо слышно... напиши лучше",
                    ]
                    await asyncio.sleep(random.uniform(1, 3))
                    await message.answer(random.choice(_stt_fail_replies))
                    return
            else:
                incoming_text = message.text

            # Защита от дублирования: если пользователь уже обрабатывается — игнорируем
            if message.from_user.id in self._processing_users:
                return
            self._processing_users.add(message.from_user.id)

            try:
                user_id = self.memory.get_or_create_user(
                    str(message.from_user.id),
                    message.from_user.username,
                    message.from_user.first_name
                )

                # Определяем тип сообщения
                msg_text = incoming_text.lower()

                # --- Запрос фото ---
                _scene_type = detect_explicit_scene(msg_text)
                _is_intimate = any(trigger in msg_text for trigger in INTIMATE_PHOTO_TRIGGERS)
                _is_photo = any(trigger in msg_text for trigger in PHOTO_TRIGGERS)
                if _scene_type or _is_intimate or _is_photo:
                    self._processing_users.discard(message.from_user.id)
                    _trust = self._trust_for(user_id)
                    if _scene_type:
                        effective_trust = 6
                    elif _is_intimate:
                        effective_trust = 5
                    else:
                        effective_trust = _trust
                    await handle_photo_request(
                        message.from_user.id, self.bot,
                        trust_level=effective_trust,
                        scene_type=_scene_type,
                    )
                    return
                if any(word in msg_text for word in ["привет", "здравствуй", "хай"]):
                    msg_type = "greeting"
                elif any(word in msg_text for word in ["люби", "нравишься", "красив"]):
                    msg_type = "flirt"
                elif any(word in msg_text for word in ["семья", "отец", "мать", "работа"]):
                    msg_type = "personal"
                else:
                    msg_type = "normal"

                # Если сейчас время сна — проверяем принудительное пробуждение
                if self._is_sleeping(user_id):
                    if self._mentions_elina(incoming_text):
                        # Инкрементируем счётчик упоминаний имени
                        try:
                            conn = sqlite3.connect(Config.DB_PATH)
                            cur = conn.cursor()
                            cur.execute(
                                "UPDATE users SET elina_name_count = COALESCE(elina_name_count, 0) + 1 WHERE id = ?",
                                (user_id,)
                            )
                            cur.execute("SELECT elina_name_count FROM users WHERE id = ?", (user_id,))
                            name_count = cur.fetchone()[0] or 0
                            conn.commit()
                            conn.close()
                        except Exception as e:
                            print(f"Name count error: {e}")
                            name_count = 0

                        if name_count >= 5:
                            # ПРОБУЖДЕНИЕ — устанавливаем wake_until далеко вперёд
                            wake_until = datetime.now(pytz.utc) + timedelta(minutes=9999)
                            try:
                                conn = sqlite3.connect(Config.DB_PATH)
                                cur = conn.cursor()
                                cur.execute(
                                    "UPDATE users SET wake_until = ?, elina_name_count = 0 WHERE id = ?",
                                    (wake_until.isoformat(), user_id)
                                )
                                conn.commit()
                                conn.close()
                            except Exception as e:
                                print(f"Wake set error: {e}")

                            wake_replies = [
                                "окей, окей, я здесь... что случилось?",
                                "слышу тебя... что-то срочное?",
                                "хм... ладно, проснулась. что?",
                                "ай, хорошо... тут. что случилось?",
                            ]
                            await asyncio.sleep(random.uniform(1, 3))
                            reply = random.choice(wake_replies)
                            await message.answer(reply)
                            self.memory.save_message(user_id, "assistant", reply)
                            self.memory.save_message(user_id, "user", incoming_text)
                            return
                    else:
                        # Не упоминает имя — сбрасываем счётчик
                        try:
                            conn = sqlite3.connect(Config.DB_PATH)
                            cur = conn.cursor()
                            cur.execute("UPDATE users SET elina_name_count = 0 WHERE id = ?", (user_id,))
                            conn.commit()
                            conn.close()
                        except Exception as e:
                            print(f"Name count reset error: {e}")

                    # Молчим — сохраняем сообщение для утреннего ответа
                    self.memory.save_message(user_id, "user", incoming_text)
                    return

                # Получаем задержку
                trust_level = self._trust_for(user_id)
                mood = self.behavior.get_mood_by_hour()

                delay = self.behavior.get_response_delay(msg_type, trust_level)

                # Утреннее поведение: отвечаем на пропущенные ночные сообщения
                schedule = self.get_sleep_schedule()
                wake_hour = schedule["wake"]
                current_hour = datetime.now(ELINA_TZ).hour
                hours_since_wake = (current_hour - wake_hour) % 24
                just_woke = hours_since_wake <= 2

                if just_woke:
                    unread = self.memory.get_unread_user_messages(user_id)
                    if unread:
                        last_unread = unread[-1]
                        try:
                            # LLM оценивает актуальность ночного сообщения
                            relevance_check = await self.llm.generate_response(
                                "Ты определяешь актуальность сообщений. Отвечай строго одним словом: да или нет.",
                                f'Пользователь написал ночью: "{last_unread}". Сейчас утро. Это сообщение ещё актуально?',
                                []
                            )
                            if "да" in relevance_check.lower():
                                morning_prompt = (
                                    f'Элина только проснулась. Увидела что ночью написали: "{last_unread}". '
                                    f'Ответь на это сообщение естественно — как будто только открыла глаза и взяла телефон. '
                                    f'Можно упомянуть что видишь ночное сообщение.'
                                )
                                morning_reply = await self.llm.generate_response(
                                    self.soul.get_system_prompt(trust_level, "только проснулась"),
                                    morning_prompt,
                                    self.memory.get_recent_messages(user_id, 10)
                                )
                                _, morning_reply = self.validator.validate(morning_reply, trust_level)
                                parts = self.behavior.split_message(morning_reply)
                                for part in parts:
                                    if part.strip():
                                        await message.answer(part)
                                        await asyncio.sleep(random.uniform(2, 5))
                                self.memory.save_message(user_id, "assistant", morning_reply)
                        except Exception as e:
                            print(f"Morning behavior error: {e}")

                # Если принудительно проснулась (по имени) — продлеваем wake_until на 30 мин
                # только если сейчас естественное время сна
                if self._is_sleeping():  # без user_id = проверка только по времени
                    try:
                        conn = sqlite3.connect(Config.DB_PATH)
                        cur = conn.cursor()
                        cur.execute("SELECT wake_until FROM users WHERE id = ?", (user_id,))
                        row = cur.fetchone()
                        if row and row[0]:
                            new_wake = datetime.now(pytz.utc) + timedelta(minutes=30)
                            cur.execute(
                                "UPDATE users SET wake_until = ? WHERE id = ?",
                                (new_wake.isoformat(), user_id)
                            )
                            conn.commit()
                        conn.close()
                    except Exception as e:
                        print(f"Wake extend error: {e}")

                # Сохраняем сообщение пользователя
                self.memory.save_message(user_id, "user", incoming_text)

                # Ждём (имитация набора)
                await asyncio.sleep(delay)

                # Получаем контекст (последние 20 сообщений)
                context = self.memory.get_recent_messages(
                    user_id,
                    Config.MAX_CONTEXT_MESSAGES
                )

                # Обогащаем запрос знаниями (learned_facts / веб-поиск)
                # voice_mode: voice / text / switch (switch = streak exceeded)
                voice_mode = self.voice_counter.get_reply_mode(message.from_user.id, is_voice)

                extra_context = await self.enrich_with_knowledge(incoming_text, trust_level)
                enriched_message = f"{incoming_text}\n{extra_context}" if extra_context else incoming_text
                if voice_mode == "switch":
                    enriched_message += (
                        "\n\n[СНАЧАЛА ответь на сообщение по смыслу в своём стиле. "
                        "Потом добавь одну короткую фразу — что тебе сложно долго "
                        "отвечать голосовыми, пусть лучше пишет. Одна фраза, в конце, живо.]"
                    )
                # Генерируем ответ через Claude API
                system_prompt = self.soul.get_system_prompt(trust_level, mood)
                response = await self.llm.generate_response(
                    system_prompt,
                    enriched_message,
                    context
                )

                # Сохраняем ответ в learned_facts если использовался веб-поиск
                if extra_context.startswith("<web_result>"):
                    question_key = incoming_text.lower().strip()[:100]
                    self.memory.save_learned_fact(question_key, response, "web")

                # Добавляем несовершенства
                imperfect = self.behavior.add_imperfection(response)

                if isinstance(imperfect, list):
                    typo_msg, correction_msg = imperfect
                    _, typo_msg = self.validator.validate(typo_msg, trust_level)
                    messages_to_send = [typo_msg, correction_msg]
                else:
                    response = imperfect
                    _, response = self.validator.validate(response, trust_level)
                    messages_to_send = self.behavior.split_message(response)

                # Отправляем
                if voice_mode in ("voice", "switch"):
                    tts_text = " ".join(m for m in messages_to_send if m.strip())
                    tts_text = _prepare_tts(tts_text)
                    _, _, current_mood = _elina_state(datetime.now(ELINA_MSK_TZ).hour)
                    is_owner = (OWNER_ID and message.from_user.id == OWNER_ID)
                    cached = self.voice_cache.get(tts_text, mood=current_mood)
                    ogg_bytes = cached or await self.tts.generate(tts_text, mood=current_mood, bypass_limit=is_owner)
                    if ogg_bytes:
                        if not cached:
                            self.voice_cache.put(tts_text, ogg_bytes, mood=current_mood)
                        await message.answer_voice(BufferedInputFile(ogg_bytes, filename="voice.ogg"))
                    else:
                        for msg in messages_to_send:
                            if msg.strip():
                                await message.answer(msg)
                                await asyncio.sleep(random.uniform(3, 7))
                else:
                    for msg in messages_to_send:
                        if msg.strip():
                            await message.answer(msg)
                            await asyncio.sleep(random.uniform(3, 7))

                # Сохраняем ответ
                self.memory.save_message(user_id, "assistant", response)

                # Увеличиваем счётчик
                self.memory.increment_message_count(user_id)

            finally:
                self._processing_users.discard(message.from_user.id)
    
    async def _proactive_loop(self):
        """Фоновая задача: Элина пишет первой при долгом молчании"""
        await asyncio.sleep(60)  # даём боту прогреться
        while True:
            await asyncio.sleep(30 * 60)  # проверка каждые 30 минут

            # Не пишем во время сна
            if self._is_sleeping():
                continue

            hour = datetime.now(ELINA_TZ).hour

            try:
                users = self.memory.get_active_users()
                now = datetime.now()

                for user_id, telegram_id in users:
                    last_msg_time = self.memory.get_last_user_message_time(user_id)
                    if not last_msg_time:
                        continue

                    silence_hours = (now - last_msg_time).total_seconds() / 3600

                    # Не пишем если уже написали за последние 4 часа
                    last_proactive = self._proactive_sent.get(user_id)
                    if last_proactive and (now - last_proactive).total_seconds() < 4 * 3600:
                        continue

                    msg = None
                    if 4 <= silence_hours <= 6:
                        msg = random.choice([
                            "ты куда пропал?", "луна тут скучает...", "всё хорошо?",
                            "сижу у окна. дождь", "слушай, а ты любишь осень?"
                        ])
                    elif 12 <= silence_hours <= 24:
                        if 10 <= hour < 12:
                            msg = "доброе утро"
                        elif 14 <= hour < 20:
                            msg = "как ты сегодня?"
                    elif silence_hours > 72:
                        three_day_key = f"3days_{user_id}"
                        if three_day_key not in self._proactive_sent:
                            msg = "скучала..."
                            self._proactive_sent[three_day_key] = now

                    if msg:
                        # Проверяем непрочитанные сообщения от пользователя
                        unread = self.memory.get_unread_user_messages(user_id)
                        if unread:
                            # Есть непрочитанные — отвечаем на последнее вместо проактивного
                            last_unread = unread[-1]
                            try:
                                trust_level = self._trust_for(user_id)
                                mood = self.behavior.get_mood_by_hour()
                                system_prompt = self.soul.get_system_prompt(trust_level, mood)
                                context = self.memory.get_recent_messages(user_id, Config.MAX_CONTEXT_MESSAGES)
                                reply = await self.llm.generate_response(system_prompt, last_unread, context)
                                _, reply = self.validator.validate(reply, trust_level)
                                parts = self.behavior.split_message(reply)
                                for part in parts:
                                    if part.strip():
                                        await self.bot.send_message(int(telegram_id), part)
                                        await asyncio.sleep(random.uniform(1, 3))
                                self.memory.save_message(user_id, "assistant", reply)
                                self._proactive_sent[user_id] = now
                                print(f"Replied to unread from {telegram_id}: {repr(reply)}")
                            except Exception as e:
                                print(f"Unread reply error {telegram_id}: {e}")
                        else:
                            try:
                                await self.bot.send_message(int(telegram_id), msg)
                                self.memory.save_message(user_id, "assistant", msg)
                                self._proactive_sent[user_id] = now
                                print(f"Proactive: sent to {telegram_id}: {msg}")
                            except Exception as e:
                                print(f"Proactive send error {telegram_id}: {e}")
            except Exception as e:
                print(f"Proactive loop error: {e}")

    async def run(self):
        """Запуск бота"""
        self._ensure_wake_columns()  # миграция БД
        print("🤖 ELINA Brain запущен...")
        print(f"📦 Модель: {config.MODEL} (Anthropic Claude)")
        print(f"🎭 Character Bible: {config.SOUL_MD_PATH}")
        print(f"💾 БД: {config.DB_PATH}")
        print("=" * 50)
        asyncio.create_task(self._proactive_loop())
        await self.dp.start_polling(self.bot)

