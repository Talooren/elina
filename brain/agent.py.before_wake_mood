            "желание"
        ]
        
        response_lower = response.lower()
        
        for topic in forbidden:
            if topic in response_lower and trust_level < 4:
                return False, "хм... не хочу об этом. а ты как?"
        
        if len(response) > 500:
            return False, "ой, я что-то заболталась... короче, всё ок)"
        
        return True, response

