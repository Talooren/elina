    @staticmethod
    def split_message(text: str) -> list:
        """Разбить ответ Claude на отдельные сообщения по переносу строки.
        Обрабатывает и реальный \n, и буквальную последовательность \\n из ответов LLM."""
        normalized = text.replace('\\n', '\n')
        parts = [p.strip() for p in normalized.split('\n') if p.strip() and len(p.strip()) > 15]
        return parts if len(parts) > 1 else [normalized.strip()]

